{
  "name": "notemind-db",
  "version": "1.0.0",
  "description": "PostgreSQL database with pgvector, Prisma ORM, and Express API for NoteMind",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:api": "ts-node scripts/test-api.ts",
    "db:seed": "ts-node scripts/seed.ts",
    "db:verify": "ts-node scripts/verify-db.ts",
    "benchmark:explain": "ts-node scripts/benchmark-explain.ts",
    "benchmark:nplusone": "ts-node scripts/demonstrate-nplusone.ts",
    "db:backup-restore": "ts-node scripts/backup-restore.ts",
    "db:reembed": "ts-node scripts/reembed.ts",
    "db:ocr-heal": "ts-node scripts/heal-scanned-notes.ts",
    "test:ocr": "ts-node scripts/ocr-smoke-test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@google/genai": "^2.30.0",
    "@napi-rs/canvas": "^1.0.13",
    "@prisma/client": "^5.14.0",
    "@types/multer": "^2.3.0",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^7.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
