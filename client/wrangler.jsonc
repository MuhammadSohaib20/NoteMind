{
  // The Worker name must match the existing workers.dev hostname:
  //   https://notemind.sohaibzaheer1987.workers.dev
  "name": "notemind",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-17",

  // Only the Vite build output is uploaded. Deploying the source folder was
  // what produced the blank page (the browser was served /src/main.tsx).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },

  // The Express API is the Render service defined in ../render.yaml. The URL
  // carries a suffix because the plain `notemind-api` hostname was taken.
  // A plain var is enough: it is not a secret, and every GitHub deploy carries
  // it, so a fresh checkout cannot forget to configure the proxy.
  "vars": {
    "API_ORIGIN": "https://notemind-api-7wc5.onrender.com"
  },

  "observability": {
    "enabled": true
  }
}
