# ============================================
# NoteMind - Environment Configuration
# Copy to .env and fill in your own values.
# ============================================

# ---------- Database ----------
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/notemind"

# ---------- Auth ----------
# Change this to a long random string before deploying.
JWT_SECRET="notemind_super_secret_jwt_key_2026"

# ---------- Server ----------
PORT=3000

# ---------- Google AI Studio (Gemini) ----------
# Get a key at https://aistudio.google.com/apikey
# The FREE tier requires no credit card. Free-tier prompts and responses may be
# used to improve Google products; link a billing account to opt out.
GEMINI_API_KEY=

# Model ids live here so that upgrading the provider is a configuration
# change and never a code change.
#   Embedding: gemini-embedding-2 (768-dim, matches the vector(768) column)
#   Generation: gemini-3.8-flash
AI_EMBED_MODEL="gemini-embedding-2"
AI_GEN_MODEL="gemini-3.8-flash"
AI_GEN_FALLBACK_MODEL="gemini-3.5-flash-lite"

# Embedding dimensionality. 768 matches the existing vector(768) column.
# Valid values for both embedding models: 128, 256, 512, 768, 1536, 3072.
AI_EMBED_DIM=768

# Requests per minute allowed against the provider. The Gemini free tier sits
# around 10 RPM for the 3.x Flash models.
AI_MAX_RPM=10

# Retry attempts for transient provider failures (429 / 5xx / network).
AI_MAX_ATTEMPTS=5

# Local cache directory for embeddings. Cached vectors cost no provider quota.
AI_CACHE_DIR=".ai-cache"

# ---------- Groq (optional second generation provider) ----------
# Free tier, used automatically when the primary provider fails.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
AI_GROQ_MODEL="qwen/qwen3.8-27b"

# Per-request timeout against the AI provider (ms).
AI_TIMEOUT_MS=30000

# Minimum cosine similarity for a chunk to count as relevant (0 - 1).
AI_MIN_SIMILARITY=0.25

# ---------- Scanned PDF OCR (no Python) ----------
# Pages rendered + recognised per uploaded scanned PDF. OCR uses tesseract.js
# (WebAssembly) inside Node; language data loads from ./eng.traineddata when
# present, otherwise from the CDN.
PDF_OCR_MAX_PAGES=20